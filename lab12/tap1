import json
import os

# 1. input.txt файлын автоматты түрде жасау
filename = "input.txt"
data_lines = [
    "Арманов Ерлан,85",
    "Сәдуақасов Айдар,92",
    "ҚатеЖолФорматыБұл",  # Тест үшін қате жол
    "Нұрланұлы Данияр,78",
    "Қасымова Әсел,95",
    "Мұратбек Асқар,88"
]

# Егер файл жоқ болса, жаңадан жасаймыз
if not os.path.exists(filename):
    with open(filename, "w", encoding="utf-8") as f:
        for line in data_lines:
            f.write(line + "\n")

valid_records = []
error_count = 0
non_empty_count = 0

# 2. Файлды ашып, оқу және қате жолдарды өңдеу (В тапсырмасы)
with open(filename, "r", encoding="utf-8") as file:
    for line in file:
        stripped = line.strip()
        
        # Бос жолдарды аттап өту
        if stripped == "":
            continue
            
        non_empty_count += 1
        
        # Қате форматты қауіпсіз тексеру (try-except)
        try:
            # Үтірдің бар-жоғын тексеру
            if "," not in stripped:
                raise ValueError("Үтір жоқ")
                
            parts = stripped.split(",")
            if len(parts) != 2:
                raise ValueError("Бөліктер саны қате")
                
            name = parts[0].strip()
            score = int(parts[1].strip()) # Ұпайды санға түрлендіру
            
            # Тізімге қосу
            valid_records.append({"participant": name, "score": score})
            
        except Exception as e:
            error_count += 1
            print(f"Қате жол табылды (өткізілді): '{stripped}'")

# 3. Есептеулер жасау (5-нұсқа: Ең жоғары ұпай және орташа ұпай)
if len(valid_records) > 0:
    scores = []
    for item in valid_records:
        scores.append(item["score"])
        
    max_score = max(scores)
    avg_score = sum(scores) / len(scores)
else:
    max_score = 0
    avg_score = 0

# 4. Нәтижені report.txt файлына жазу
with open("report.txt", "w", encoding="utf-8") as report:
    report.write("5-НҰСҚА: СПОРТ НӘТИЖЕЛЕРІ\n")
    report.write(f"Бос емес жолдар саны: {non_empty_count}\n")
    report.write(f"Дұрыс өңделген жазбалар саны: {len(valid_records)}\n")
    report.write(f"Қате өткізілген жолдар саны: {error_count}\n")
    report.write(f"Ең жоғары ұпай: {max_score}\n")
    report.write(f"Орташа ұпай: {avg_score:.1f}\n")

# 5. Деректерді data.json файлына сақтау
with open("data.json", "w", encoding="utf-8") as json_file:
    json.dump(valid_records, json_file, ensure_ascii=False, indent=2)

print("\n--- Бағдарлама сәтті аяқталды! ---")
print("report.txt және data.json файлдары құрылды.")

# 6. JSON файлын қайта оқып тексеру
with open("data.json", "r", encoding="utf-8") as json_file:
    restored = json.load(json_file)
    print(f"JSON-нан оқылған жазбалар саны: {len(restored)}")
    print(f"Бірінші қатысушы: {restored[0]['participant']}, Ұпайы: {restored[0]['score']}")
