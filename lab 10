# --- 3-нұсқа бойынша зертханалық жұмыс ---

# 1. Берілген мәліметтерді енгіземіз
text = "Кітапхана студенттерге кітап ұсынады. Кітап білім көзі."
search_word = "кітап"
old_word = "білім"
new_word = "ақпарат"
code_value = "EF-789"
print("=== 3-НҰСҚА НӘТИЖЕЛЕРІ ===")
print("Бастапқы мәтін:", text)
print("-" * 40)
# 2. Мәтін ұзындығы, сөздер мен таңбалар санын табу
# Ұзындығын len() арқылы табамыз
text_uzyn2 = len(text)
print("1) Мәтін ұзындығы:", text_uzyn2)
# split() арқылы сөздерді тізімге бөлеміз
sozder_tizimi = text.split()
print("   Сөздер саны:", len(sozder_tizimi))
# Бос орын емес таңбаларды санау үшін қарапайым цикл қолданамыз
bos_emes_tanba = 0
for simvol in text:
    if simvol != " ":  # егер бос орын болмаса
        bos_emes_tanba += 1
print("   Бос орын емес таңбалар саны:", bos_emes_tanba)
print("-" * 40)
# 3. Іздеу жұмысы (регистрге тәуелсіз ету үшін lower() қолданамыз)
kisi_text = text.lower()
kisi_soz = search_word.lower()
# Алғашқы индексін табу
indeks = kisi_text.find(kisi_soz)
print(f"2) '{search_word}' сөзінің алғашқы индексі:", indeks)
# Неше рет кездесетінін санау
ret_sany = kisi_text.count(kisi_soz)
print(f"   '{search_word}' сөзінің кездесу саны:", ret_sany)
print("-" * 40)
# 4. Сөзді алмастыру (replace)
zhana_text = text.replace(old_word, new_word)
print(f"3) Алмастыру нәтижесі ('{old_word}' -> '{new_word}'):")
print("   ", zhana_text)
print("-" * 40)
# 5. Код пішімін тексеру (XX-999 үлгісі, мысалы: EF-789)
# Мұнда қарапайым шарттарды (if-else) қолданамыз
kod = code_value.strip()
# Шарттарды бөлек-бөлек тексеріп көреміз
uzyndygy_duris = len(kod) == 6
bas_aripter = kod[0].isupper() and kod[1].isupper() and kod[0].isalpha() and kod[1].isalpha()
orta_siziq = kod[2] == "-"
sifrlar = kod[3].isdigit() and kod[4].isdigit() and kod[5].isdigit()

print(f"4) Кодты тексеру ({code_value}):")
if uzyndygy_duris and bas_aripter and orta_siziq and sifrlar:
    print("   Нәтиже: Дұрыс пішім (XX-999)")
else:
    print("   Нәтиже: Қате пішім")
print("=" * 40)
